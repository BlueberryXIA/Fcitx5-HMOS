/*
 * Symbol and emoji tables for the picker panels.
 *
 * Structure follows fcitx5-android's PickerData: a list of categories, each a
 * flat array that the panel paginates.  The grid shape differs per picker
 * because character widths differ: symbols are narrow and pack 10 to a row,
 * emoji are square and fit 7.  Both grids are three rows tall.
 */

/** One tab in a picker: a label plus its entries in display order. */
export interface PickerCategory {
  label: string;
  entries: string[];
}

/** Columns per row in the symbol grid. */
export const SYMBOL_COLUMNS: number = 10;
/** Rows per symbol page. */
export const SYMBOL_ROWS: number = 3;
/** Entries shown per symbol page. */
export const SYMBOL_PAGE_SIZE: number = SYMBOL_COLUMNS * SYMBOL_ROWS;

/** Columns per row in the emoji grid. */
export const EMOJI_COLUMNS: number = 7;
/** Rows per emoji page. */
export const EMOJI_ROWS: number = 3;
/** Entries shown per emoji page. */
export const EMOJI_PAGE_SIZE: number = EMOJI_COLUMNS * EMOJI_ROWS;

